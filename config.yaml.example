# Azure DevOps TUI Configuration
# Copy this file to ~/.config/azdo-tui/config.yaml and edit the values

# Azure DevOps organization name (required)
organization: your-org-name

# Azure DevOps project name(s) (required)
# Simple format (API name shown in UI):
#   projects:
#     - your-project-name
# With display names (friendly name shown in UI, API name used for requests):
#   projects:
#     - name: ugly-api-project-name
#       display_name: My Project
#     - simple-project
# Multiple projects (shows combined view with "Project" column):
projects:
  - your-project-name

# GitHub (optional). One or more "owner/repo" slugs enables the GitHub
# backend. Not required for the Notifications tab below -- Azure DevOps
# alone is enough to show it.
# github:
#   repos:
#     - your-org/your-repo

# Polling interval in seconds (optional, default: 60)
polling_interval: 60

# Theme (optional, default: dark)
# Built-in themes: dark, gruvbox, nord, dracula, catppuccin, github
# Custom themes: Place JSON theme files in ~/.config/azdo-tui/themes/
# Example: If you have ~/.config/azdo-tui/themes/mytheme.json, use: theme: mytheme
theme: dark

# Disable specific panes (optional, comma-separated).
# Valid values: pullrequests, pipelines, workitems, notifications.
# At least one pane must remain enabled.
# disabled_panes: pipelines,workitems

# Tab labels (optional). Override the name shown for any tab — in both the tab
# bar and the help dialog. Keys are lowercase snake_case and must match exactly
# (config keys are lowercased on load). Unset tabs keep their default labels.
#
# terms:
#   pull_requests: PRs
#   work_items: Tasks
#   pipelines: Builds
#   metrics: Dashboard

# Notifications tab. On by default whenever at least one backend is
# configured (Azure DevOps, GitHub, or both) — there is deliberately no
# notifications.enabled key; use disabled_panes above
# (disabled_panes: notifications) to turn it off instead. Azure's share of
# the feed is synthesized from four polled sources (Azure DevOps has no
# notifications inbox API to read from); GitHub's share comes from its
# actual inbox. Every key is optional. The filter keys default to the widest
# possible behaviour (nothing filtered); the azure block is the exception --
# lookback_days and min_poll_interval default to real bounds. Takes effect on
# next restart.
#
# notifications:
#   # Shared keys — apply to the merged feed across every backend.
#   exclude_reasons: []         # drop rows by *why* they're in the feed; accepts:
#                                #   review_requested, mentioned, assigned, authored,
#                                #   commented, state_changed, ci_activity,
#                                #   security_alert, approval_requested, subscribed,
#                                #   other
#                                # lowercase snake_case, case-sensitive ("Subscribed"
#                                # warns and is dropped). "unknown" is reserved and
#                                # not accepted. exclude_repos, exclude_reasons and
#                                # unread_only are an order-independent AND -- each
#                                # only ever removes rows.
#   unread_only: false          # show only unread rows (client-side; GitHub's fetch
#                                # always requests the whole inbox regardless)
#   exclude_repos: []           # glob list (path.Match syntax) of scopes to hide
#                                # from the feed -- a GitHub "owner/repo" slug or an
#                                # Azure project name, depending which backend
#                                # produced the row; "*" does not cross "/" -- write
#                                # "*/*" to mean "everything"
#   include_repos: []           # same glob syntax as exclude_repos, narrowing
#                                # instead of hiding; ignored for the WHOLE feed
#                                # when notifications.github.only_configured_repos
#                                # is true (with a startup warning), not just for
#                                # the GitHub rows -- non-GitHub rows then pass
#                                # through unnarrowed
#   max_items: 0                 # cap the number of notifications in the merged
#                                # feed across every backend, applied once after
#                                # the newest-first sort; 0 = no cap
#   poll_interval: 0             # override polling_interval for notifications
#                                # only, in seconds; 0 = fall back to
#                                # polling_interval. A capable backend's own
#                                # cadence hint (GitHub's X-Poll-Interval response)
#                                # can still raise this above what's configured,
#                                # never lower it
#
#   # GitHub-only keys.
#   github:
#     only_configured_repos: false # narrow the GitHub share of the feed to
#                                    # github.repos; wins over include_repos when
#                                    # both are set -- include_repos is then
#                                    # ignored for every row, with a startup
#                                    # warning, and non-GitHub rows pass through
#                                    # unnarrowed
#     participating_only: false    # narrow the server-side fetch to GitHub's
#                                    # "participating" bundle (roughly everything
#                                    # except subscribed); composes with
#                                    # exclude_reasons
#     since_days: 0                 # only show GitHub notifications updated in
#                                    # the last N days; 0 = no bound. The knob to
#                                    # reach for on a very large GitHub inbox --
#                                    # it's the one filter that actually reduces
#                                    # what's fetched from GitHub
#
#   # Azure DevOps-only keys.
#   azure:
#     lookback_days: 14            # bounds the assigned and ci_failed sources to
#                                    # activity within the last N days (default 14,
#                                    # max 30; 0 falls back to the default rather
#                                    # than meaning "unbounded")
#     min_poll_interval: 300       # minimum seconds between real Azure
#                                    # notification queries; calls within the
#                                    # window reuse the previous result instead of
#                                    # querying Azure again (default 300, max
#                                    # 86400; 0 falls back to the default rather
#                                    # than disabling the throttle)
#     sources:                      # per-source enable toggles, all true by default
#       review_requested: true      # open PRs where you're a reviewer
#       mentioned: true              # work-item @mentions
#       assigned: true               # work items assigned to you
#       ci_failed: true              # pipeline runs requested by you whose
#                                    # result is 'failed' -- emits the ci_activity
#                                    # reason above, a deliberately different name
#                                    # from this key

# Metrics tab (opt-in, management dashboard). Disabled unless enabled: true.
# When enabled a fourth tab surfaces per-user WIP, stuck-item flags, and
# points-closed over the configured interval.
#
# metrics:
#   enabled: false
#   interval_days: 14            # window for "points closed" / velocity
#   active_stale_days: 3         # dwell in Active above this flags the item
#   rft_stale_days: 2            # dwell in Ready for Test above this flags the item
#   wip_limit: 4                 # in-flight strictly above this marks a user overloaded
#   run_one_shot_backfill: false # set true once to seed 90 days of history via /updates;
#                                # creates a marker file so it never runs twice. Delete
#                                # ~/.config/azdo-tui/.metrics-backfill-done to re-run.
#   states:                      # configurable state names (case-insensitive matching)
#     active: Active
#     ready_for_test: Ready for Test
#     closed: Closed
#   state_labels:                # optional column-header overrides; auto-derived from
#                                # state names when absent (e.g. "Ready for Test" → "rft")
#     active: active
#     ready_for_test: rft
#     closed: closed
